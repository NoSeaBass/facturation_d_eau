  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: palette(window);
}

QWidget#centralwidget {
    background: palette(window);
}

QLineEdit#titleLabel {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                               stop: 0 palette(highlight),
                               stop: 1 palette(dark));
    color: palette(highlighted-text);
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 15px;
    padding: 20px;
    text-align: center;
}

QFrame#cardFrame, QFrame#cardFrame_2 {
    background-color: palette(base);
    border: 2px solid palette(mid);
    border-radius: 10px;
    margin: 5px;
}

QFrame#cardFrame:hover, QFrame#cardFrame_2:hover {
    border-color: palette(highlight);
    background-color: palette(alternate-base);
}

QLabel#gestionTitle, QLabel#listesTitle {
    font-size: 18px;
    font-weight: bold;
    color: palette(text);
    padding: 15px;
    margin: 0px;
}

QPushButton {
    background-color: palette(button);
    color: palette(button-text);
    border: 2px solid palette(mid);
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    min-width: 180px;
    min-height: 40px;
    text-align: left;
}

QPushButton:hover {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border-color: palette(highlight);
}

QPushButton:pressed {
    background-color: palette(dark);
}

QMenuBar {
    background-color: palette(window);
    color: palette(window-text);
    border-bottom: 1px solid palette(mid);
    font-size: 14px;
    padding: 5px;
}

QMenuBar::item {
    padding: 8px 16px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QStatusBar {
    background-color: palette(window);
    color: palette(window-text);
    border-top: 1px solid palette(mid);
    font-size: 12px;
    padding: 5px;
}</string>
