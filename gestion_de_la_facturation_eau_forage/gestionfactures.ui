  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: palette(window);
}

QWidget#centralwidget {
    background-color: palette(window);
}

QTableWidget {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 6px;
    gridline-color: palette(midlight);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
    font-size: 11pt;
    outline: none;
}

QTableWidget::item {
    border: none;
    border-bottom: 1px solid palette(midlight);
}

QTableWidget::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QTableWidget::item:hover {
    background-color: palette(midlight);
}

QHeaderView::section {
    background-color: palette(button);
    color: palette(buttonText);
    border: none;
    border-bottom: 2px solid palette(mid);
    border-right: 1px solid palette(mid);
    font-weight: 600;
    font-size: 11pt;
}

QHeaderView::section:hover {
    background-color: palette(midlight);
}

QPushButton {
    background-color: palette(button);
    color: palette(buttonText);
    border: 1px solid palette(mid);
    border-radius: 6px;
    font-size: 11pt;
    font-weight: 500;
    min-height: 16px;
}

QPushButton:hover {
    background-color: palette(midlight);
    border-color: palette(dark);
}

QPushButton:pressed {
    background-color: palette(mid);
}

QPushButton#nouvelleFacture {
    background-color: #2563eb;
    color: white;
    border: none;
}

QPushButton#nouvelleFacture:hover {
    background-color: #1d4ed8;
}

QPushButton#nouvelleFacture:pressed {
    background-color: #1e40af;
}

QPushButton#pushButton {
    background-color: palette(button);
    border: 1px solid palette(mid);
}

/* Styles globaux pour tous les boutons dans les cellules du tableau */
QTableWidget QWidget QPushButton {
    background-color: palette(button);
    color: palette(buttonText);
}

QTableWidget QWidget QPushButton:hover {
    background-color: palette(midlight);
    border-color: palette(dark);
}

QTableWidget QWidget QPushButton:pressed {
    background-color: palette(mid);
}

/* Styles pour les widgets conteneurs dans les cellules */
QTableWidget QWidget {
    background-color: transparent;
    border: none;
}

QLabel#titleLabel {
    color: palette(windowText);
    font-size: 24pt;
    font-weight: 600;
    margin: 0px;
    padding: 20px 0px;
}

QLabel#infoLabel {
    color: palette(mid);
    font-size: 10pt;
}

QMenuBar {
    background-color: palette(window);
    color: palette(windowText);
    border-bottom: 1px solid palette(mid);
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QStatusBar {
    background-color: palette(window);
    border-top: 1px solid palette(mid);
    color: palette(windowText);
    padding: 4px;
}</string>
