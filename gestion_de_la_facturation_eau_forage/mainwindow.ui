  <property name="styleSheet">
   <string notr="true">/* Utilisation des couleurs et thèmes par défaut de Qt avec améliorations subtiles */

QMainWindow {
    background-color: palette(window);
}

QWidget {
    font-family: "Segoe UI", "Roboto", sans-serif;
}

/* Titre de connexion */
QLabel#titleLabel {
    font-size: 16pt;
    font-weight: bold;
    color: palette(text);
    padding: 12px 0px;
    qproperty-alignment: AlignCenter;
}

/* Labels des champs */
QLabel {
    font-size: 9pt;
    color: palette(text);
    font-weight: 500;
    padding: 3px 0px;
}

/* Champs de saisie */
QLineEdit {
    border: 2px solid palette(mid);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 9pt;
    background-color: palette(base);
    color: palette(text);
    min-height: 16px;
}

QLineEdit:focus {
    border-color: palette(highlight);
    background-color: palette(base);
}

QLineEdit:hover {
    border-color: palette(dark);
}

/* Bouton de connexion */
QPushButton {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 10pt;
    font-weight: 600;
    min-height: 16px;
    min-width: 100px;
}

QPushButton:hover {
    background-color: palette(dark);
}

QPushButton:pressed {
    background-color: palette(shadow);
}

QPushButton:disabled {
    background-color: palette(mid);
    color: palette(disabled-text);
}

/* Frame conteneur pour un meilleur style */
QFrame#loginFrame {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 10px;
    padding: 15px;
    max-width: 320px;
    max-height: 260px;
}

/* MenuBar */
QMenuBar {
    background-color: palette(window);
    color: palette(text);
    border-bottom: 1px solid palette(mid);
    spacing: 3px;
}

QMenuBar::item {
    padding: 6px 10px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QMenuBar::item:pressed {
    background-color: palette(dark);
}

/* StatusBar */
QStatusBar {
    background-color: palette(window);
    color: palette(text);
    border-top: 1px solid palette(mid);
}
</string>
  </property>
